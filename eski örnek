    def _recolor_widget_tree(self, widget: tk.Misc, previous: dict[str, str]) -> None:
        """Recolor surfaces and text independently, preserving contrast when gray values overlap."""
        surface_roles = ("background", "panel", "panel_alt", "field", "selection",
                         "scrollbar", "accent", "accent_active")
        surface_map = {
            previous[role]: THEME[role]
            for role in surface_roles
            if role in previous and previous[role] != THEME[role]
        }
        text_roles = ("text", "muted")
        text_map = {
            previous[role]: THEME[role]
            for role in text_roles
            if role in previous and previous[role] != THEME[role]
        }
        if isinstance(widget, RoundedButton):
            if widget._background in surface_map:
                widget._background = surface_map[widget._background]
            if widget._accent in surface_map:
                widget._accent = surface_map[widget._accent]
            if widget._hover in surface_map:
                widget._hover = surface_map[widget._hover]
            try:
                widget.configure(background=widget._background)
            except tk.TclError:
                pass
            widget._draw()
        option_maps = {
            "background": surface_map,
            "activebackground": surface_map,
            "highlightbackground": surface_map,
            "selectbackground": surface_map,
            "troughcolor": surface_map,
            "foreground": text_map,
            "activeforeground": text_map,
            "selectforeground": text_map,
            "insertbackground": text_map,
            "disabledforeground": text_map,
        }
        for option, color_map in option_maps.items():
            try:
                old_color = widget.cget(option)
            except (tk.TclError, KeyError):
                continue
            if old_color in color_map:
                try:
                    widget.configure(**{option: color_map[old_color]})
                except tk.TclError:
                    pass
        try:
            children = widget.winfo_children()
        except tk.TclError:
            children = []
        for child in children:
            self._recolor_widget_tree(child, previous)

