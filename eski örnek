        try:
            json_path.write_text(json.dumps(report, ensure_ascii=False, indent=2, allow_nan=False), encoding="utf-8")
            table = [
                "# FIRSAT-KONTROL PANELİ — Tek Motor Raporu",
                "",
                f"- Rapor zamanı: {report['created_at_local']}",
                f"- Uygulama sürümü: {APP_VERSION}",
