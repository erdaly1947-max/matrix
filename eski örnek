    def _sync_risk_rows(self, *_args: Any) -> None:
        """Refresh two compact entry-control rows using the live plan values."""
        values = self.risk_vars
        rows = {
            "scenario": (
                f"senaryo / zaman dilimi: {values['scenario'].get()}   ·   "
                f"olası giriş bölgesi: {values['entry'].get()}"
            ),
            "breakout": (
                f"kırılım seviyesi: {values['breakout'].get()}   ·   "
                f"zarar durdurma: {values['stop'].get()}"
            ),
        }
        segments = {
            "scenario": [
                ("senaryo / zaman dilimi: ", "scenario_title"),
                (values["scenario"].get(), None),
                ("   ·   ", None),
                ("olası giriş bölgesi: ", "entry_title"),
                (values["entry"].get(), None),
            ],
            "breakout": [
                ("kırılım seviyesi: ", "breakout_title"),
                (values["breakout"].get(), None),
                ("   ·   ", None),
                ("zarar durdurma: ", "stop_title"),
                (values["stop"].get(), None),
            ],
        }
