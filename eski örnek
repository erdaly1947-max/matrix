    def _play_alert_tone(self, kind: str, *, force: bool = False) -> None:
        if not force and not self.alarm_sound_enabled_var.get():
            return
        volume = max(0, min(100, int(self.alarm_volume_var.get())))
        if volume <= 0:
            return
        threading.Thread(
            target=self._play_alert_tone_worker, args=(kind, volume),
            daemon=True, name=f"alert-tone-{kind}",
        ).start()

    def _play_alert_tone_worker(self, kind: str, volume: int) -> None:
        """Synthesize a short, volume-scaled WAV; Windows playback runs off the Tk thread."""
        if os.name != "nt":
            return
        patterns = {
            "strong": ((880, 0.12), (1175, 0.16)),
            "test": ((880, 0.12), (1175, 0.16)),
            "entry": ((620, 0.09), (790, 0.12)),
            "breakout": ((1040, 0.17),),
            "target": ((740, 0.09), (1050, 0.14)),
            "stop": ((390, 0.22), (290, 0.26)),
        }
        tones = patterns.get(kind, patterns["strong"])
        sample_rate = 22050
        sound_path: Path | None = None
        try:
            with self._audio_lock:
                with tempfile.NamedTemporaryFile(prefix="fkp_alarm_", suffix=".wav", delete=False) as temp:
                    sound_path = Path(temp.name)
                frames = bytearray()
                amplitude = int(32767 * (volume / 100.0) * 0.42)
                for frequency, seconds in tones:
                    frame_count = int(sample_rate * seconds)
                    for index in range(frame_count):
                        fade = min(1.0, index / 220.0, (frame_count - index) / 220.0)
                        sample = int(
                            amplitude * fade *
                            math.sin(2.0 * math.pi * frequency * index / sample_rate)
                        )
                        frames.extend(struct.pack("<h", sample))
                    frames.extend(b"\x00\x00" * int(sample_rate * 0.035))
                with wave.open(str(sound_path), "wb") as wav_file:
                    wav_file.setnchannels(1)
                    wav_file.setsampwidth(2)
                    wav_file.setframerate(sample_rate)
                    wav_file.writeframes(frames)
                import winsound
                winsound.PlaySound(str(sound_path), winsound.SND_FILENAME)
        except Exception as exc:
            self._append_log(f"Alarm sesi çalınamadı ({kind}): {exc}")
        finally:
            if sound_path is not None:
                try:
                    sound_path.unlink(missing_ok=True)
                except OSError:
                    pass

    @staticmethod
    def _positive_price(value: Any) -> float | None:
        try:
            result = float(value)
        except (TypeError, ValueError, OverflowError):
            return None
        return result if math.isfinite(result) and result > 0 else None

    def _toggle_level_tracking(self) -> None:
        if self.level_tracking_enabled_var.get():
            self._stop_level_tracking("Kullanıcı seviye takibini kapattı.")
            return
        selection = self.candidate_tree.selection()
        if not selection:
            messagebox.showwarning(
                "Seviye takibi", "Önce tabloda bir coin seçin.", parent=self.root
            )
            return
        symbol = selection[0]
        row = self._rows_by_symbol.get(symbol)
        if not isinstance(row, dict) or not self._state_is_live() or row.get("data_freshness") != "CANLI AKIŞ GÜNCEL":
            messagebox.showwarning(
                "Seviye takibi",
                "Seviye takibi yalnızca seçilen coin'in güncel canlı verisi varken başlatılabilir.",
                parent=self.root,
            )
            return
        plan = row.get("risk_plan") if isinstance(row.get("risk_plan"), dict) else {}
        low = self._positive_price(plan.get("entry_zone_low"))
        high = self._positive_price(plan.get("entry_zone_high"))
        breakout = self._positive_price(plan.get("breakout_level"))
        stop = self._positive_price(plan.get("stop_loss"))
        targets_raw = plan.get("targets") if isinstance(plan.get("targets"), list) else []
        targets = []
        for index, target in enumerate(targets_raw[:3], start=1):
            if not isinstance(target, dict):
                continue
            price = self._positive_price(target.get("price"))
            if price is not None:
                targets.append((str(target.get("name") or f"Hedef {index}"), price, index))
        if low is None or high is None or high < low or breakout is None or stop is None or not targets:
            messagebox.showwarning(
                "Seviye takibi",
                "Bu coin için geçerli giriş bölgesi, kırılım, stop ve en az bir hedef seviyesi yok.",
                parent=self.root,
            )
            return
        self._tracked_symbol = symbol
        self._tracked_plan = {
            "symbol": symbol, "entry_low": low, "entry_high": high,
            "breakout": breakout, "stop": stop, "targets": targets,
        }
        self._level_alert_fired.clear()
        self._last_monitored_price = None
        self._tracking_initial_baseline_set = False
        self._level_pause_reason = None
        self.level_tracking_enabled_var.set(True)
        self._refresh_alarm_controls()
        self.alert_banner.set(
            f"Seviye takibi başladı: {symbol}; mevcut planın fiyat seviyeleri izleniyor."
        )
        self._append_log(
            f"Seviye takibi başladı: {symbol}; plan seviyeleri sabitlendi, motor otomatik emir göndermez."
        )
        self._update_price_level_tracking()

    def _stop_level_tracking(self, reason: str) -> None:
        if self.level_tracking_enabled_var.get() or self._tracked_symbol:
            self._append_log(f"Seviye takibi kapandı: {reason}")
        self.level_tracking_enabled_var.set(False)
        self._tracked_symbol = None
        self._tracked_plan = None
        self._level_alert_fired.clear()
        self._last_monitored_price = None
        self._tracking_initial_baseline_set = False
        self._level_pause_reason = None
        if hasattr(self, "level_tracking_button"):
            self._refresh_alarm_controls()

    def _evaluate_level_crossings(self, previous: float, current: float) -> list[tuple[str, str]]:
        """Return one event per level crossing and re-arm only after price recrosses away."""
        plan = self._tracked_plan
        if not isinstance(plan, dict):
            return []
        symbol = str(plan.get("symbol") or self._tracked_symbol or "coin")
        events: list[tuple[str, str]] = []
        low, high = float(plan["entry_low"]), float(plan["entry_high"])
        was_in_entry = low <= previous <= high
        is_in_entry = low <= current <= high
        crossed_entry = (
            (not was_in_entry and is_in_entry)
            or (previous < low and current > high)
            or (previous > high and current < low)
        )
        if crossed_entry and "entry" not in self._level_alert_fired:
            self._level_alert_fired.add("entry")
            events.append((
                "entry",
                f"{symbol}: olası giriş bölgesine ulaşıldı ({low:.8g}–{high:.8g} USDT).",
            ))
        elif "entry" in self._level_alert_fired and not is_in_entry:
            self._level_alert_fired.discard("entry")

        breakout = float(plan["breakout"])
        if "breakout" in self._level_alert_fired and current < breakout:
            self._level_alert_fired.discard("breakout")
        if "breakout" not in self._level_alert_fired and previous < breakout <= current:
            self._level_alert_fired.add("breakout")
            events.append(("breakout", f"{symbol}: kırılım seviyesi aşıldı ({breakout:.8g} USDT)."))

        for name, price, target_index in plan.get("targets", []):
            key = f"target:{target_index}"
            if key in self._level_alert_fired and current < price:
                self._level_alert_fired.discard(key)
            if key not in self._level_alert_fired and previous < price <= current:
                self._level_alert_fired.add(key)
                events.append(("target", f"{symbol}: {name} seviyesine ulaşıldı ({price:.8g} USDT)."))

        stop = float(plan["stop"])
        if "stop" in self._level_alert_fired and current > stop:
            self._level_alert_fired.discard("stop")
        if "stop" not in self._level_alert_fired and previous > stop >= current:
            self._level_alert_fired.add("stop")
            events.append(("stop", f"{symbol}: zarar durdurma seviyesi görüldü ({stop:.8g} USDT)."))
        return events

    def _emit_level_alert(self, kind: str, message: str) -> None:
        self.alert_banner.set("SEVİYE ALARMI | " + message)
        self._append_log("SEVİYE ALARMI | " + message)
        self._play_alert_tone(kind)

    def _update_price_level_tracking(self) -> None:
        """Pause on stale input; after data resumes use one fresh price as a new baseline."""
        if not self.level_tracking_enabled_var.get() or not isinstance(self._tracked_plan, dict):
            return
        symbol = str(self._tracked_symbol or "")
        row = self._rows_by_symbol.get(symbol)
        if (
            not self._state_is_live()
            or not isinstance(row, dict)
            or row.get("data_freshness") != "CANLI AKIŞ GÜNCEL"
        ):
            reason = "canlı veri güncel değil"
            if self._level_pause_reason != reason:
                self._append_log(f"Seviye takibi bekletildi: {symbol} — {reason}.")
            self._level_pause_reason = reason
            self._last_monitored_price = None
            return
        current = self._positive_price(row.get("latest_price"))
        if current is None:
            reason = "geçerli fiyat verisi yok"
            if self._level_pause_reason != reason:
                self._append_log(f"Seviye takibi bekletildi: {symbol} — {reason}.")
            self._level_pause_reason = reason
            self._last_monitored_price = None
            return
        if self._level_pause_reason is not None:
            self._append_log(f"Seviye takibi yeniden başladı: {symbol} — güncel veriyle başlangıç fiyatı alındı.")
        self._level_pause_reason = None
        if self._last_monitored_price is None:
            self._last_monitored_price = current
            if not self._tracking_initial_baseline_set:
                self._tracking_initial_baseline_set = True
                plan = self._tracked_plan
                if (
                    isinstance(plan, dict)
                    and float(plan["entry_low"]) <= current <= float(plan["entry_high"])
                    and "entry" not in self._level_alert_fired
                ):
                    self._level_alert_fired.add("entry")
                    self._emit_level_alert(
                        "entry",
                        f"{symbol}: güncel fiyat mevcut olası giriş bölgesinde "
                        f"({float(plan['entry_low']):.8g}–{float(plan['entry_high']):.8g} USDT).",
                    )
            return
        previous = self._last_monitored_price
        self._last_monitored_price = current
        events = self._evaluate_level_crossings(previous, current)
        played_kinds: set[str] = set()
        for kind, message in events:
            self.alert_banner.set("SEVİYE ALARMI | " + message)
            self._append_log("SEVİYE ALARMI | " + message)
            if kind not in played_kinds:
                self._play_alert_tone(kind)
                played_kinds.add(kind)

