    def _apply_windows_titlebar_theme(self) -> None:
        """Match the Windows title bar to the current gray palette when supported."""
        if os.name != "nt":
            return
        try:
            from ctypes import wintypes
            user32, dwmapi = ctypes.windll.user32, ctypes.windll.dwmapi
            user32.GetAncestor.argtypes = [wintypes.HWND, wintypes.UINT]
            user32.GetAncestor.restype = wintypes.HWND
            hwnd = user32.GetAncestor(wintypes.HWND(self.root.winfo_id()), 2)
            if not hwnd:
                hwnd = wintypes.HWND(self.root.winfo_id())
            set_attribute = dwmapi.DwmSetWindowAttribute
            set_attribute.argtypes = [wintypes.HWND, wintypes.DWORD, ctypes.c_void_p, wintypes.DWORD]
            set_attribute.restype = ctypes.c_long
            def set_value(attribute: int, value: Any) -> bool:
                return set_attribute(hwnd, attribute, ctypes.byref(value), ctypes.sizeof(value)) == 0
            shade = int(THEME["background"][1:3], 16)
            dark_mode = ctypes.c_int(1 if shade < 145 else 0)
            if not set_value(20, dark_mode):
                set_value(19, dark_mode)
            background_rgb = THEME["background"].lstrip("#")
            foreground_rgb = THEME["text"].lstrip("#")
            background_bgr = int(background_rgb[4:6] + background_rgb[2:4] + background_rgb[0:2], 16)
            foreground_bgr = int(foreground_rgb[4:6] + foreground_rgb[2:4] + foreground_rgb[0:2], 16)
            set_value(35, ctypes.c_uint32(background_bgr))
            set_value(36, ctypes.c_uint32(foreground_bgr))
        except Exception:
            return


