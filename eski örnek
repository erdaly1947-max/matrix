    @staticmethod
    def _state_age(state: dict[str, Any]) -> float | None:
        value = state.get("generated_at_utc")
        try:
            stamp = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
            if stamp.tzinfo is None:
                stamp = stamp.replace(tzinfo=timezone.utc)
            return max(0.0, (datetime.now(timezone.utc) - stamp.astimezone(timezone.utc)).total_seconds())
        except (TypeError, ValueError, OverflowError):
            return None

    def _state_is_live(self) -> bool:
        if self.process is None or self.process.poll() is not None:
            return False
        age = self._state_age(self._state)
        if (
            self._state.get("status") != "CANLI AKIŞ GÜNCEL"
            or age is None or age > 90
            or self._state.get("settings_changed_since_load") is True
        ):
            return False
        total = int(self._state.get("websocket_total_shards") or 0)
        connected = int(self._state.get("websocket_connected_shards") or 0)
        return total > 0 and total == connected

    def _candidate_is_current(self, row: dict[str, Any] | None) -> bool:
        """Require the candidate row and shared engine state to both be current."""
        return (
            isinstance(row, dict)
            and row.get("data_freshness") == "CANLI AKIŞ GÜNCEL"
            and self._state_is_live()
        )

    def _current_rows(self) -> list[dict[str, Any]]:
        candidates = self._state.get("candidates")
        if not isinstance(candidates, list):
            return []
        rows = []
        for row in candidates:
            if not isinstance(row, dict):
                continue
            if (
                row.get("phase") not in ("A", "B", "C")
                and row.get("last_known_phase") not in ("A", "B", "C")
                and _final_decision_text(row) == "KARAR BEKLENİYOR"
            ):
                continue
            rows.append(row)
        # The motor ranks candidates by decision, score, phase, higher-timeframe context,
        # and evidence. Preserve that exact order for the panel, alert lifecycle, and report.
        return rows

    def _strong_rows(self) -> dict[tuple[str, str], tuple[dict[str, Any], str]]:
        if not self._state_is_live() or self._state.get("strong_alerts_enabled") is not True:
            return {}
        output: dict[tuple[str, str], tuple[dict[str, Any], str]] = {}
        for row in self._current_rows():
            if row.get("data_freshness") != "CANLI AKIŞ GÜNCEL":
                continue
            if row.get("strong_alarm_eligible") is not True:
                continue
            reason = _strong_opportunity_reason(row)
            if not reason:
                continue
            symbol = str(row.get("symbol") or "").strip().upper()
            timeframe = str(row.get("phase_timeframe") or "").strip()
            if symbol and timeframe:
                output[(symbol, timeframe)] = (row, reason)
        return output

    def _refresh_alert_lifecycle(self) -> None:
        now = time.monotonic()
        current = self._strong_rows()
        rows_by_symbol = {
            str(row.get("symbol") or "").strip().upper(): row
            for row in self._current_rows() if str(row.get("symbol") or "").strip()
        }
        state_is_live = self._state_is_live()
        alerts_enabled = self._state.get("strong_alerts_enabled") is True
        btc_gate = self._state.get("btc_strong_alert_gate")
        btc_context_current_and_eligible = (
            isinstance(btc_gate, dict)
            and btc_gate.get("fresh") is True
            and btc_gate.get("complete") is True
            and btc_gate.get("eligible") is True
        )
        global_permission_revoked = (
            state_is_live
            and self._state.get("strong_alerts_enabled") is False
            and btc_context_current_and_eligible
        )
        btc_confirmed_risk_closes_alert = (
            state_is_live
            and not alerts_enabled
            and isinstance(btc_gate, dict)
            and btc_gate.get("fresh") is True
            and btc_gate.get("complete") is True
            and (
                bool(btc_gate.get("critical_level_loss_timeframes"))
                or btc_gate.get("extreme_volatility") is True
            )
        )
        btc_gate_reasons = (
            [item.strip() for item in btc_gate.get("reasons", [])
             if isinstance(item, str) and item.strip()]
            if isinstance(btc_gate, dict) and isinstance(btc_gate.get("reasons"), list)
            else []
        )
        active_keys = set(self._active_opportunities)
        new_alerts = []
        invalidated_messages: list[str] = []
        for key, (row, reason) in current.items():
            self._inactive_since.pop(key, None)
            self._inactive_elapsed.pop(key, None)
            if key not in active_keys:
                new_alerts.append((key, row, reason))
                self._last_alert_reason[key] = reason
            active_keys.add(key)

        for key in list(active_keys):
            if key in current:
                continue
            row = rows_by_symbol.get(key[0])
            explicitly_invalidated = (
                state_is_live and isinstance(row, dict)
                and row.get("data_freshness") == "CANLI AKIŞ GÜNCEL"
                and row.get("strong_alarm_eligible") is True
                and str(row.get("phase_timeframe") or "").strip() == key[1]
                and row.get("final_decision") == "FIRSAT GEÇERSİZ"
            )
            if explicitly_invalidated:
                reason = row.get("decision_reason")
                reason_text = (
                    " ".join(reason.split())
                    if isinstance(reason, str) and reason.strip()
                    else "Teknik senaryo güncel verilerle geçersiz sayıldı."
                )
                message = f"FIRSAT GEÇERSİZ: {key[0]} {key[1]} — {reason_text}"
                active_keys.discard(key)
                self._inactive_since.pop(key, None)
                self._inactive_elapsed.pop(key, None)
                self._last_alert_reason.pop(key, None)
                self._append_log(message)
                invalidated_messages.append(message)
                continue
            if btc_confirmed_risk_closes_alert:
                reason_text = "; ".join(btc_gate_reasons[:2]) or (
                    "BTC kritik destek/kanal kaybı veya aşırı oynaklık eşiği doğrulandı."
                )
                message = (
                    f"GÜÇLÜ FIRSAT ALARMI KAPANDI: BTC piyasa risk kapısı — "
                    f"{key[0]} {key[1]} — {reason_text}"
                )
                active_keys.discard(key)
                self._inactive_since.pop(key, None)
                self._inactive_elapsed.pop(key, None)
                self._last_alert_reason.pop(key, None)
                self._append_log(message)
                invalidated_messages.append(message)
                continue
            row_permission_revoked = (
                state_is_live
                and btc_context_current_and_eligible
                and isinstance(row, dict)
                and row.get("data_freshness") == "CANLI AKIŞ GÜNCEL"
                and row.get("btc_market_context_freshness") == "CANLI AKIŞ GÜNCEL"
                and str(row.get("phase_timeframe") or "").strip() == key[1]
                and row.get("strong_alarm_eligible") is False
            )
            if global_permission_revoked or row_permission_revoked:
                if global_permission_revoked:
                    raw_warning = self._state.get("alert_filter_warning")
                    reason_text = (
                        " ".join(raw_warning.split())
                        if isinstance(raw_warning, str) and raw_warning.strip()
                        else "Genel parite/ayar uygunluk izni kaldırıldı."
                    )
                    permission_label = "genel alarm izni kaldırıldı"
                else:
                    raw_warning = row.get("strong_alarm_block_reason")
                    reason_text = (
                        " ".join(raw_warning.split())
                        if isinstance(raw_warning, str) and raw_warning.strip()
                        else "Parite güçlü alarm uygunluğunu kaybetti."
                    )
                    permission_label = "parite alarm uygunluğu kaldırıldı"
                message = (
                    f"GÜÇLÜ FIRSAT ALARMI KAPANDI: {permission_label} — "
                    f"{key[0]} {key[1]} — {reason_text}"
                )
                active_keys.discard(key)
                self._inactive_since.pop(key, None)
                self._inactive_elapsed.pop(key, None)
                self._last_alert_reason.pop(key, None)
                self._append_log(message)
                invalidated_messages.append(message)
                continue
            can_confirm_inactive = (
                state_is_live and alerts_enabled and isinstance(row, dict)
                and row.get("data_freshness") == "CANLI AKIŞ GÜNCEL"
                and row.get("strong_alarm_eligible") is True
            )
            if not can_confirm_inactive:
                # Accumulate only time during which fresh data actually confirms absence.
                since = self._inactive_since.pop(key, None)
                if since is not None:
                    self._inactive_elapsed[key] = self._inactive_elapsed.get(key, 0.0) + max(0.0, now - since)
                continue
            since = self._inactive_since.setdefault(key, now)
            fresh_absence_seconds = self._inactive_elapsed.get(key, 0.0) + max(0.0, now - since)
            if fresh_absence_seconds >= 300.0:
                active_keys.discard(key)
                self._inactive_since.pop(key, None)
                self._inactive_elapsed.pop(key, None)
                self._last_alert_reason.pop(key, None)
                self._append_log(
                    f"Fırsat sona erdi: {key[0]} {key[1]} — koşul 300 saniyedir güncel verilerle doğrulanmıyor."
                )

        self._active_opportunities = active_keys
        self._last_strong_keys = set(current)
        for key, row, reason in new_alerts:
            price = row.get("latest_price")
            price_text = f"{float(price):.10g}" if isinstance(price, (int, float)) else "belirsiz"
            message = (
                f"GÜÇLÜ FIRSAT | motor=Binance Spot | veri=CANLI AKIŞ GÜNCEL | "
                f"parite={key[0]} | fiyat={price_text} USDT | {reason}"
            )
            self.alert_banner.set(message)
            self._append_log(message)
            self._play_alert_tone("strong")
        if not current and not new_alerts:
            if invalidated_messages:
                self.alert_banner.set(invalidated_messages[-1])
            elif self._state.get("strong_alerts_enabled", True) is False:
                disabled_reasons: list[str] = []
                btc_gate = self._state.get("btc_strong_alert_gate")
                if isinstance(btc_gate, dict) and btc_gate.get("eligible") is False:
                    raw_reasons = btc_gate.get("reasons")
                    if isinstance(raw_reasons, list):
                        disabled_reasons.extend(
                            item.strip() for item in raw_reasons
                            if isinstance(item, str) and item.strip()
                        )
                filter_warning = self._state.get("alert_filter_warning")
                if isinstance(filter_warning, str) and filter_warning.strip():
                    cleaned_warning = " ".join(filter_warning.split())
                    if cleaned_warning not in disabled_reasons:
                        disabled_reasons.append(cleaned_warning)
                if disabled_reasons:
                    self.alert_banner.set(
                        "Güçlü fırsat alarmı kapalı: " + " | ".join(disabled_reasons[:2])
                    )
                else:
                    self.alert_banner.set(
                        "Güçlü fırsat alarmı kapalı: filtre ve BTC uygunluk gerekçesi mevcut değil."
                    )
            elif self._state_is_live():
                self.alert_banner.set("Canlı veri güncel. Şu anda güçlü fırsat koşullarını karşılayan aday yok.")
            elif self.process is not None and self.process.poll() is None:
                self.alert_banner.set("Veri güncelliği/bağlantı doğrulanamadı. Güçlü fırsat alarmı kapalı.")
            else:
                self.alert_banner.set("Alarm yalnızca güncel verilerle doğrulanan güçlü fırsatlarda etkinleşir.")

    def _refresh_candidates(self) -> None:
        rows = self._current_rows()
        engine_live = self._state_is_live()
        selected = self.candidate_tree.selection()
        selected_symbol = selected[0] if selected else None
        try:
            old_yview = self.candidate_tree.yview()
        except tk.TclError:
            old_yview = (0.0, 1.0)
        y_was_at_bottom = old_yview[0] > 0.001 and old_yview[1] >= 0.995
        self._rows_by_symbol = {}
        wanted: set[str] = set()
        for row in rows:
            symbol = str(row.get("symbol") or "").upper()
            if not symbol:
                continue
            wanted.add(symbol)
            self._rows_by_symbol[symbol] = row
            freshness = str(row.get("data_freshness") or "veri durumu bilinmiyor")
            candidate_is_live = engine_live and freshness == "CANLI AKIŞ GÜNCEL"
            is_current_phase = candidate_is_live and row.get("phase") in PHASE_COLORS
            phase = row.get("phase") if is_current_phase else (
                row.get("last_known_phase") or row.get("phase")
            )
            price = row.get("latest_price")
            price_text = (
                f"{float(price):.10g}"
                if candidate_is_live and isinstance(price, (int, float))
                and not isinstance(price, bool)
                and math.isfinite(float(price)) and float(price) > 0
                else "—"
            )
            display_row = row if candidate_is_live else {
                **row, "data_freshness": "CANLI VERİ ESKİ/EKSİK"
            }
            decision_text = _final_decision_text(display_row)
            score_text = _opportunity_score_text(display_row)
            if is_current_phase and phase in PHASE_COLORS:
                phase_text = {"A": "A · Hazırlık", "B": "B · İlk teyit", "C": "C · Devam"}[phase]
            elif phase in PHASE_COLORS:
                phase_text = f"Son {phase} · Eski"
            else:
                phase_text = "—"
            freshness_text = (
                "Güncel" if candidate_is_live else
                "Eski/eksik" if (
                    not engine_live
                    or freshness in {"CANLI VERİ ESKİ/EKSİK", "GÜNCEL DEĞİL"}
                ) else "Bilinmiyor"
            )
            values = (
                symbol, decision_text, score_text, phase_text, price_text,
                freshness_text, str(row.get("phase_timeframe") or "—"),
            )
            tag = phase if is_current_phase and phase in PHASE_COLORS else (
                "stale" if not candidate_is_live else "decision"
            )
            if self.candidate_tree.exists(symbol):
                self.candidate_tree.item(symbol, values=values, tags=(tag,))
            else:
                self.candidate_tree.insert("", "end", iid=symbol, values=values, tags=(tag,))
        for item in self.candidate_tree.get_children():
            if item not in wanted and item != "__NO_CANDIDATES__":
                self.candidate_tree.delete(item)
        if not rows:
            if not self.candidate_tree.exists("__NO_CANDIDATES__"):
                self.candidate_tree.insert("", "end", iid="__NO_CANDIDATES__",
                    values=("Aday yok", "Karar bekleniyor", "—", "—", "—", "Tarama bekleniyor", "—"),
                    tags=("empty",))
        elif self.candidate_tree.exists("__NO_CANDIDATES__"):
            self.candidate_tree.delete("__NO_CANDIDATES__")
        if selected_symbol and selected_symbol in wanted:
            self.candidate_tree.selection_set(selected_symbol)
            # Refresh the detail/risk area without moving the user's viewport.
            self._show_selected_candidate()
        elif rows and not self.candidate_tree.selection():
            self.candidate_tree.selection_set(str(rows[0].get("symbol") or "").upper())
            self._show_selected_candidate()
        elif not rows:
            self.selected_candidate_var.set("Coin seçilmedi")
            self._set_text(self.detail, "Şu an aşama taşıyan aday yok. Tarama motoru çalışıyor olabilir; veri durumu yukarıda gösterilir.")
            self._update_risk_summary(None)
        try:
            self.candidate_tree.yview_moveto(1.0 if y_was_at_bottom else old_yview[0])
        except tk.TclError:
            pass
        self._update_price_level_tracking()

    def _update_risk_summary(self, row: dict[str, Any] | None) -> None:
        """Update the separate risk strip from the selected candidate's current plan."""
        empty_values = {
            "scenario": "—", "entry": "—", "breakout": "—", "stop": "—",
            "targets": "—", "risk": "—", "rr": "—", "status": "Plan yok",
        }
        if not isinstance(row, dict):
            for key, value in empty_values.items():
                self.risk_vars[key].set(value)
            self.risk_note_var.set("Coin seçin. Sayısal plan yalnızca güncel veri ve yeterli teknik kanıtla üretilir.")
            return

        if not self._candidate_is_current(row):
            for key, value in empty_values.items():
                self.risk_vars[key].set(value)
            self.risk_vars["scenario"].set("güncel değil")
            self.risk_vars["status"].set("Veri bekleniyor")
            if row.get("data_freshness") == "CANLI AKIŞ GÜNCEL":
                self.risk_note_var.set(
                    "Genel motor/veri durumu güncel olarak doğrulanamadı; eski giriş, "
                    "zarar durdurma ve hedef seviyeleri gösterilmiyor."
                )
            else:
                self.risk_note_var.set(
                    "Canlı veri eski/eksik: mum akışı doğrulanmadı; eski giriş, "
                    "zarar durdurma ve hedef seviyeleri gösterilmiyor."
                )
            return

        plan = row.get("risk_plan") if isinstance(row.get("risk_plan"), dict) else {}
        latest_phase = row.get("phase")
        phase = latest_phase or "Aşama yok"
        timeframe = plan.get("timeframe") or row.get("phase_timeframe") or "—"

        def number(value: Any) -> str:
            if isinstance(value, (int, float)):
                try:
                    return f"{float(value):.8g}"
                except (TypeError, ValueError, OverflowError):
                    return "—"
            return "—"

        entry_low, entry_high = plan.get("entry_zone_low"), plan.get("entry_zone_high")
        if entry_low is not None and entry_high is not None:
            entry = f"{number(entry_low)} – {number(entry_high)} USDT"
        else:
            entry = "—"
        targets = plan.get("targets") if isinstance(plan.get("targets"), list) else []
        target_parts = []
        rewards = []
        for index, target in enumerate(targets[:3], start=1):
            if not isinstance(target, dict):
                continue
            target_name = str(target.get("name") or f"Hedef {index}")
            target_parts.append(f"{target_name}: {number(target.get('price'))}")
            reward = target.get("risk_reward", target.get("risk_multiple"))
            if isinstance(reward, (int, float)):
                rewards.append(f"{number(reward)}R")
        self.risk_vars["scenario"].set(f"{phase} / {timeframe}")
        self.risk_vars["entry"].set(entry)
        self.risk_vars["breakout"].set(number(plan.get("breakout_level")) + (" USDT" if plan.get("breakout_level") is not None else ""))
        self.risk_vars["stop"].set(number(plan.get("stop_loss")) + (" USDT" if plan.get("stop_loss") is not None else ""))
        self.risk_vars["targets"].set(" | ".join(target_parts) if target_parts else "—")
        risk_pct = plan.get("risk_pct")
        self.risk_vars["risk"].set(f"%{number(risk_pct)}" if risk_pct is not None else "—")
        self.risk_vars["rr"].set(" / ".join(rewards) if rewards else "—")
        self.risk_vars["status"].set(str(plan.get("status") or "Plan yok"))
        note = str(plan.get("reason") or plan.get("target_basis") or plan.get("note") or
                   "Plan üretilemedi; yeterli güncel teknik veri bulunmuyor.")
        costs_note = str(plan.get("costs_note") or "")
        if costs_note:
            note += " " + costs_note
        self.risk_note_var.set(note)

    def _show_selected_candidate(self, _event: Any = None) -> None:
        selection = self.candidate_tree.selection()
        if not selection:
            return
        if (
            self.level_tracking_enabled_var.get()
            and self._tracked_symbol
            and selection[0] != self._tracked_symbol
        ):
            self._stop_level_tracking(
                f"Aday seçimi {selection[0]} olarak değişti; önceki coin'in seviye takibi kapatıldı."
            )
        row = self._rows_by_symbol.get(selection[0])
        if row is None:
            return
        candidate_is_live = self._candidate_is_current(row)
        display_row = dict(row)
        if not candidate_is_live:
            display_row["data_freshness"] = "CANLI VERİ ESKİ/EKSİK"
        visible_phase = row.get("phase") if candidate_is_live else None
        last_phase = row.get("last_known_phase") or row.get("phase")
        phase_label = (visible_phase if visible_phase in PHASE_COLORS else
                       f"Son {last_phase} — güncel değil" if last_phase in PHASE_COLORS else "Aşama yok")
        decision_text = _final_decision_text(display_row)
        score_text = _opportunity_score_text(display_row)
        self.selected_candidate_var.set(
            f"{row.get('symbol', '—')} | {decision_text} | Puan {score_text}/100"
            f" | {phase_label} | {row.get('phase_timeframe') or '—'}"
        )
        self._update_risk_summary(row)
        findings = row.get("findings") if isinstance(row.get("findings"), list) else []
        missing = row.get("missing_checks") if isinstance(row.get("missing_checks"), list) else []
        tf_assessments = row.get("timeframes") if isinstance(row.get("timeframes"), dict) else {}
        freshness = "CANLI AKIŞ GÜNCEL" if candidate_is_live else "CANLI VERİ ESKİ/EKSİK"
        freshness_display = (
            "canlı akış güncel" if candidate_is_live else "canlı veri eski/eksik"
        )

        def clipped(value: Any, limit: int = 78) -> str:
            text_value = " ".join(str(value).split())
            return text_value if len(text_value) <= limit else text_value[:limit - 1].rstrip() + "…"

        phase_text = (
            visible_phase if visible_phase in PHASE_COLORS else
            f"Son bilinen aşama: {last_phase} — güncel değil"
            if last_phase in PHASE_COLORS else "Güncel aşama yok"
        )
        lines = [
            f"Nihai karar: {decision_text} | Fırsat puanı: {score_text}/100",
            f"Aşama: {phase_text} | zaman dilimi: {row.get('phase_timeframe') or '—'}",
            f"Veri: {freshness_display} | fiyat: {row.get('latest_price', '—') if candidate_is_live else '—'} USDT | "
            f"Keşif yolu: {_discovery_path(row) if candidate_is_live else 'son kayıt — güncellik doğrulanamadı'}",
        ]
        decision_reason = row.get("decision_reason")
        if freshness != "CANLI AKIŞ GÜNCEL":
            decision_reason = "Canlı veri eski/eksik; güncel karar bekleniyor."
        if not isinstance(decision_reason, str) or not decision_reason.strip():
            gate_reasons = row.get("strong_opportunity_gate_reasons")
            decision_reason = next(
                (item for item in gate_reasons if isinstance(item, str) and item.strip()),
                "Karar gerekçesi motor kaydında bulunmuyor.",
            ) if isinstance(gate_reasons, list) else "Karar gerekçesi motor kaydında bulunmuyor."
        lines.insert(1, "Karar gerekçesi: " + clipped(decision_reason, 100))

        # Prefer the BTC-relative-strength summary and omit raw EMA/MACD/RSI/ADX/ATR metrics.
        finding_summary: list[str] = []
        relative_strength = next(
            (
                str(item) for item in findings
                if "btc" in str(item).lower() and "göreceli güç pozitif" in str(item).lower()
            ),
            None,
        )
        if relative_strength:
            finding_summary.append(clipped(relative_strength, 96))
        key_markers = ("geri test", "kırılım seviyesi sonraki", "sonraki kapanmış mumda",
                       "yükselen dip", "yönlü fiyat yapısı", "olağan dışı hacim")
        for item in findings:
            item_text = str(item)
            if item_text == relative_strength:
                continue
            if not any(marker in item_text.lower() for marker in key_markers):
                continue
            if item_text in finding_summary:
                continue
            finding_summary.append(clipped(item_text, 74))
            if len(finding_summary) >= 3:
                break
        if not finding_summary:
            finding_summary = [clipped(item, 74) for item in findings[:2]]
        findings_line = (
            "Bulgular: " + ("; ".join(finding_summary) if finding_summary else "Kayıtlı bulgu yok.")
        )
        correlation_summary = _btc_correlation_summary(row, current=candidate_is_live)
        findings_line += " | BTC korelasyonu: " + correlation_summary
        conflict_note = row.get("btc_context_conflict_note")
        if candidate_is_live and isinstance(conflict_note, str) and conflict_note.strip():
            findings_line += " | BTC/coin çelişkisi: " + clipped(conflict_note, 105)
        group_summary = row.get("group_leadership_summary") or row.get("group_leadership_basis")
        if candidate_is_live and isinstance(group_summary, str) and group_summary.strip():
            findings_line += " | Grup: " + clipped(group_summary, 84)
        lines.append(findings_line)

        missing_summary: list[str] = []
        # Leave one concise slot for the reason the strong-opportunity gate is still closed.
        for item in missing[:2]:
            missing_summary.append(clipped(item, 66))
        if candidate_is_live and decision_text != "GÜÇLÜ FIRSAT":
            gate_reasons = row.get("strong_opportunity_gate_reasons")
            if isinstance(gate_reasons, list):
                for item in gate_reasons:
                    if not isinstance(item, str) or not item.strip():
                        continue
                    if any(item.casefold() in existing.casefold() for existing in missing_summary):
                        continue
                    missing_summary.append(clipped(f"Güçlü fırsat kapısı: {item}", 66))
                    break
        if not missing_summary:
            for timeframe in ("5m", "15m", "30m", "1h", "4h", "1d", "1w", "1M"):
                assessment = tf_assessments.get(timeframe)
                if not isinstance(assessment, dict):
                    continue
                checks = assessment.get("missing_checks")
                if not isinstance(checks, list):
                    continue
                for item in checks:
                    missing_summary.append(clipped(f"{timeframe}: {item}", 66))
                    if len(missing_summary) >= 3:
                        break
                if len(missing_summary) >= 3:
                    break
        lines.append(
            "Eksik kontroller: " + ("; ".join(missing_summary) if missing_summary else "Kayıtlı eksik kontrol yok.")
        )

        lines.append("Koşullu giriş ve risk planı:")
        plan = (
            row.get("risk_plan")
            if candidate_is_live and isinstance(row.get("risk_plan"), dict)
            else None
        )

        def price_text(value: Any) -> str:
            if not isinstance(value, (int, float)):
                return "—"
            return f"{float(value):.8f}".rstrip("0").rstrip(".")

        def percent_text(value: Any) -> str:
            return f"{float(value):+.2f}%" if isinstance(value, (int, float)) else "—"

        if not isinstance(plan, dict):
            lines.append("Plan yok — güncel veri ve gerekli teknik doğrulamalar bekleniyor.")
            lines.append("Hedefler: —")
        else:
            status_text = clipped(plan.get("status") or "Plan yok", 88)
            entry_low, entry_high = plan.get("entry_zone_low"), plan.get("entry_zone_high")
            if entry_low is not None and entry_high is not None:
                entry_text = f"{price_text(entry_low)}–{price_text(entry_high)} USDT"
                reference = plan.get("entry_reference")
                if reference is not None:
                    entry_text += f" (referans {price_text(reference)})"
                lines.append(f"Durum: {status_text} | Giriş bölgesi: {entry_text}")
            else:
                lines.append(f"Durum: {status_text}")
                if plan.get("reason"):
                    lines.append("Plan notu: " + clipped(plan.get("reason"), 95))

            breakout = plan.get("breakout_level")
            stop = plan.get("stop_loss")
            risk_pct = plan.get("risk_pct")
            plan_levels = []
            if breakout is not None:
                plan_levels.append(f"Kırılım seviyesi: {price_text(breakout)} USDT")
            if stop is not None:
                plan_levels.append(f"Zarar durdurma: {price_text(stop)} USDT")
            if isinstance(risk_pct, (int, float)):
                plan_levels.append(f"Referans riski: %{float(risk_pct):.4f}")
            if plan_levels:
                lines.append(" | ".join(plan_levels))

            targets = plan.get("targets") if isinstance(plan.get("targets"), list) else []
            target_parts = []
            for index, target in enumerate(targets[:3], start=1):
                if not isinstance(target, dict):
                    continue
                name = str(target.get("name") or f"Hedef {index}")
                part = f"{name}: {price_text(target.get('price'))} USDT"
                if target.get("change_pct") is not None:
                    part += f" ({percent_text(target.get('change_pct'))})"
                reward = target.get("risk_reward", target.get("risk_multiple"))
                if isinstance(reward, (int, float)) and not isinstance(reward, bool):
                    part += f" · {float(reward):g}R"
                basis = target.get("basis")
                source_timeframes = target.get("source_timeframes")
                source_labels = [
                    str(item).strip() for item in source_timeframes
                    if isinstance(item, str) and item.strip()
                ] if isinstance(source_timeframes, list) else []
                if isinstance(basis, str) and basis.strip():
                    part += " · dayanak: " + clipped(basis, 54)
                    if source_labels:
                        part += " (" + ", ".join(source_labels[:4]) + ")"
                target_parts.append(part)

            target_display = " | ".join(target_parts) if target_parts else "—"
            net_rr = plan.get("net_risk_reward")
            net_rr_is_number = (
                isinstance(net_rr, (int, float))
                and not isinstance(net_rr, bool)
                and math.isfinite(float(net_rr))
            )
            if plan.get("costs_included") is True and net_rr_is_number:
                net_rr_label = (
                    " · Masraf sonrası net risk/getiri (ilk teknik hedef): "
                    f"{float(net_rr):.2f}"
                )
            elif plan.get("costs_included") is True:
                net_rr_label = " · Masraf sonrası net risk/getiri hesaplanamadı"
            else:
                net_rr_label = " · Masraf sonrası net risk/getiri doğrulanmadı"
            lines.append("Hedefler: " + target_display + net_rr_label)

            invalid_if = plan.get("invalid_if")
            if invalid_if:
                lines.append("Geçersizlik: " + clipped(invalid_if, 100))
            costs_note = plan.get("costs_note")
            if costs_note:
                lines.append("Maliyet notu: " + clipped(costs_note, 92))
        detail_text = "\n".join(lines)
        self._set_text(self.detail, detail_text)
        self._apply_detail_highlights(detail_text)

    def _apply_detail_highlights(self, value: str) -> None:
        """Color only key words; keep the body text and numeric values readable."""
        phrases = (
            ("senaryo / zaman dilimi:", "scenario"),
            ("Aşama:", "scenario"),
            ("zaman dilimi:", "scenario"),
            ("olası giriş bölgesi:", "entry"),
            ("Giriş bölgesi:", "entry"),
            ("Kırılım seviyesi:", "breakout"),
            ("Zarar durdurma:", "stop"),
            ("Hedef 1", "targets"),
            ("Hedef 2", "targets"),
            ("Hedef 3", "targets"),
            ("canlı akış güncel", "fresh_current"),
            ("canlı veri eski/eksik", "fresh_stale"),
            ("güncel değil", "fresh_stale"),
        )
        for _phrase, tag in phrases:
            self.detail.tag_remove(tag, "1.0", "end")
        for phrase, tag in phrases:
            offset = 0
            while True:
                index = value.find(phrase, offset)
                if index < 0:
                    break
                start = f"1.0 + {index} chars"
                end = f"1.0 + {index + len(phrase)} chars"
                self.detail.tag_add(tag, start, end)
                offset = index + len(phrase)

    def _refresh_state(self) -> None:
        state = load_json(STATE_PATH, {}) or {}
        if not isinstance(state, dict):
            state = {}
        self._state = state
        live = self._state_is_live()
        process_running = self.process is not None and self.process.poll() is None
        status = str(state.get("status") or "Durum verisi yok").strip()
        if not live and status == "CANLI AKIŞ GÜNCEL":
            status = "BAĞLANTI/VERİ UYARISI"
        if process_running and live:
            self.engine_status.set("BINANCE MOTORU ÇALIŞIYOR — CANLI VERİ GÜNCEL")
        elif process_running:
            self.engine_status.set(f"BINANCE MOTORU ÇALIŞIYOR — {status}")
        elif self.process is not None:
            return_code = self.process.poll()
            if return_code == 0:
                self.engine_status.set("Motor durdu")
            else:
                self.engine_status.set(f"Motor kapalı — çıkış kodu {return_code}")
        else:
            self.engine_status.set(f"Motor hazır — {status}")

        completed = int(state.get("bootstrap_completed") or 0)
        total = int(state.get("bootstrap_total") or 0)
        percent = int(state.get("bootstrap_progress_pct") or 0)
        successful = int(state.get("bootstrap_successful") or 0)
        errors = int(state.get("bootstrap_errors") or 0)
        skipped = int(state.get("bootstrap_skipped") or 0)
        retry_seconds = int(state.get("bootstrap_retry_seconds") or 0)
        connected_shards = int(state.get("websocket_connected_shards") or 0)
        total_shards = int(state.get("websocket_total_shards") or 0)
        message_ages = state.get("websocket_last_message_age_seconds")
        finite_ages = [
            float(age) for age in message_ages.values()
            if isinstance(age, (int, float)) and age >= 0
        ] if isinstance(message_ages, dict) else []
        live_age_text = f"{max(finite_ages):.0f} sn" if finite_ages else "henüz veri yok"
        warning_items = state.get("api_warnings")
        first_warning = warning_items[0] if isinstance(warning_items, list) and warning_items else None
        raw_error = (
            state.get("error") or state.get("settings_warning") or first_warning
            or state.get("universe_warning") or state.get("btcturk_universe_warning")
        )
        if not raw_error:
            error_text = "yok"
        else:
            normalized_error = " ".join(str(raw_error).split())
            upper_error = normalized_error.upper()
            if "WRONG_VERSION_NUMBER" in upper_error or "WRONG VERSION NUMBER" in upper_error:
                error_text = "TLS WRONG_VERSION_NUMBER"
            elif "TLS" in upper_error or "SSL" in upper_error:
                error_text = "TLS/SSL bağlantı hatası"
            elif "429" in upper_error or "418" in upper_error:
                error_text = "HTTP 429/418 hız sınırı"
            elif "TIMEOUT" in upper_error or "TIMED OUT" in upper_error:
                error_text = "Bağlantı zaman aşımı"
            else:
                error_text = normalized_error[:72] + ("…" if len(normalized_error) > 72 else "")
        if retry_seconds > 0:
            error_text += f" · tekrar {retry_seconds} sn"
        self.summary.set("\n".join((
            f"Başlangıç mum verileri: {completed}/{total} (%{percent})",
            f"WebSocket: {connected_shards}/{total_shards} bağlı · veri yaşı: {live_age_text}",
            f"Geçmiş: başarılı {successful}/{total} · hata {errors} · atlanan {skipped}",
            f"Hata: {error_text}",
        )))
        self.live_flow_var.set((
            f"motor / canlı akış: mum {completed}/{total} (%{percent}) · "
            f"websocket {connected_shards}/{total_shards} · veri yaşı {live_age_text} · "
            f"geçmiş {successful} başarılı / {errors} hata / {skipped} atlanan · "
            f"hata: {error_text}"
        ).lower())

        pair_count = state.get("common_pair_count")
        self.universe_count_var.set(
            f"{pair_count} parite" if isinstance(pair_count, int) else "Doğrulanmış sayı yok"
        )
        mode = str(state.get("universe_mode") or "—")
        mode_labels = {
            "SINGLE_ENGINE_LOCAL_LIST": "Yerel BtcTurk + Binance ortak evreni",
            "COMMON_VERIFIED": "Ortak evren doğrulandı",
            "CACHED_COMMON_FALLBACK": "Son doğrulanmış liste yedekte; güncel değil",
            "CACHED_LEGACY_UNIVERSE": "Eski ortak liste — tarihsel kaynak",
            "CACHED_BINANCE_SYMBOL_FALLBACK": "Kayıtlı ortak liste — Binance evreni güncel doğrulanmadı",
