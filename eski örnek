                if tag:
                    widget.insert("end", content, tag)
                else:
                    widget.insert("end", content)
            widget.configure(state="disabled")

    @staticmethod
    def _set_text(widget: tk.Text, value: str) -> None:
        """Replace detail text without stealing the reader's current scroll position."""
        old_value = widget.get("1.0", "end-1c")
        if old_value == value:
            return
        try:
            old_yview = widget.yview()
        except tk.TclError:
            old_yview = (0.0, 1.0)
        was_at_bottom = old_yview[0] > 0.001 and old_yview[1] >= 0.995
        widget.configure(state="normal")
        widget.delete("1.0", "end")
        widget.insert("1.0", value)
        if was_at_bottom:
            widget.yview_moveto(1.0)
        else:
            widget.yview_moveto(old_yview[0])
        widget.configure(state="disabled")

    def _append_log(self, line: str) -> None:
        """Persist diagnostics and worker stdout/stderr without adding a visible log panel."""
