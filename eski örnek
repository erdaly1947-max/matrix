        "kopyalayıp yapıştırmaya gerek yoktur.\n"
    )
    members: dict[str, bytes] = {
        f"rapor/{json_path.name}": json_path.read_bytes(),
        f"rapor/{markdown_path.name}": markdown_path.read_bytes(),
        "tani/TANI_OZETI.json": diagnostic_json,
        "tani/DEVIR_NOTU.md": transfer_note.encode("utf-8"),
        "logs/son_300_satir_tek_motor_paneli.log": log_text.encode("utf-8"),
    }
    manifest = "\n".join(
        f"{hashlib.sha256(content).hexdigest()}  {name}"
        for name, content in sorted(members.items())
    ) + "\n"
    with zipfile.ZipFile(
        bundle_path, mode="w", compression=zipfile.ZIP_DEFLATED, compresslevel=9
    ) as archive:
        for name, content in members.items():
            archive.writestr(name, content)
        archive.writestr("SHA256SUMS.txt", manifest.encode("utf-8"))
    return diagnostic


def _strong_opportunity_reason(row: dict[str, Any]) -> str | None:
    # Alerts consume the same final decision/gate output as the dashboard.
    score = _opportunity_score_value(row)
    if (
        row.get("final_decision") != "GÜÇLÜ FIRSAT"
        or row.get("strong_opportunity_qualified") is not True
        or score is None or score < 80
    ):
        return None
    phase = row.get("phase")
    if phase not in STRONG_PHASES:
        return None
    timeframe = str(row.get("phase_timeframe") or "")
    timeframes = row.get("timeframes")
    if not timeframe or not isinstance(timeframes, dict):
        return None
    assessment = timeframes.get(timeframe)
    if not isinstance(assessment, dict) or assessment.get("phase") != phase:
        return None
    metrics = assessment.get("metrics")
    if not isinstance(metrics, dict):
        return None
    if phase == "B":
        if metrics.get("directional_structure") is not True or metrics.get("volume_unusual") is not True:
            return None
        return f"{timeframe}: kapanmış mumda fiyat yapısı ve olağan dışı hacim birlikte doğrulandı."
    if metrics.get("continuity") is not True or metrics.get("continuity_volume_confirmed") is not True:
        return None
    return f"{timeframe}: önceki kırılım sonraki kapanışta korundu ve kırılım hacmi doğrulandı."


