def _python_console_exe() -> str:
    exe = Path(sys.executable)
    if exe.name.casefold() == "pythonw.exe":
        candidate = exe.with_name("python.exe")
        if candidate.exists():
            return str(candidate)
    return str(exe)


def _discovery_path(row: dict[str, Any]) -> str:
    assessments = row.get("timeframes")
    if not isinstance(assessments, dict):
        assessments = {}
    early = False
    volume = False
    breakout = False
    relative = row.get("relative_strength_vs_btc_pct_points")
    relative_positive = isinstance(relative, dict) and any(
        isinstance(value, (int, float)) and value > 0 for value in relative.values()
    )
    for assessment in assessments.values():
        if not isinstance(assessment, dict):
            continue
        metrics = assessment.get("metrics")
        if not isinstance(metrics, dict):
            continue
        early = early or any(metrics.get(key) is True for key in ("compression", "rising_lows", "near_resistance"))
        volume = volume or metrics.get("volume_unusual") is True
        close = metrics.get("close")
        level = metrics.get("breakout_level")
        closed_breakout = (
            isinstance(close, (int, float)) and not isinstance(close, bool)
            and isinstance(level, (int, float)) and not isinstance(level, bool)
            and math.isfinite(float(close)) and math.isfinite(float(level))
            and float(close) > float(level)
            and metrics.get("directional_structure") is True
            and metrics.get("volume_unusual") is True
        )
        confirmed_continuity = (
            metrics.get("continuity") is True
            and metrics.get("continuity_volume_confirmed") is True
        )
        breakout = breakout or closed_breakout or confirmed_continuity
    pathways = []
    if early:
        pathways.append("Erken güçlenme")
    if volume:
        pathways.append("Olağan dışı hacim")
    if relative_positive:
        pathways.append("Göreceli güç")
    if breakout:
        pathways.append("Kırılım/devam")
    return " + ".join(pathways) if pathways else "İnceleme"


def _btc_market_context_summary(context: Any, *, current: bool) -> str:
    """Render a compact BTC direction/level summary without leaking stale prices."""
    if not current:
        return "BTC piyasa bağlamı eski/eksik — yön, destek/direnç ve kanal seviyeleri güncel kabul edilmiyor."
    if not isinstance(context, dict):
        return "BTC piyasa bağlamı henüz mevcut değil."

    timeframe_rows = context.get("timeframes")
    timeframe_rows = timeframe_rows if isinstance(timeframe_rows, dict) else {}

    def price(value: Any) -> str:
        if not isinstance(value, (int, float)) or isinstance(value, bool):
            return "—"
        try:
            number = float(value)
            return f"{number:.7g}" if math.isfinite(number) and number > 0 else "—"
        except (TypeError, ValueError, OverflowError):
            return "—"

    def zone_text(value: Any) -> str:
        if not isinstance(value, dict):
            return "teyit yok"
        lower, upper = price(value.get("lower")), price(value.get("upper"))
        center = price(value.get("center"))
        if lower != "—" and upper != "—" and lower != upper:
            return f"{lower}–{upper}"
        return center

    frame_summaries = []
    for timeframe in ("1h", "4h"):
        row = timeframe_rows.get(timeframe)
        if not isinstance(row, dict) or row.get("available") is not True:
            frame_summaries.append(f"{timeframe}: bağlam eksik")
            continue
        direction = "yukarı" if row.get("bullish") is True else "yukarı teyit yok"
        support_labels = {
            "SON GÜÇLÜ DESTEK KORUNUYOR": "korunuyor",
            "GÜÇLÜ DESTEK BÖLGESİ TEST EDİLİYOR": "test",
            "SON GÜÇLÜ DESTEK KAYBEDİLDİ": "KAYIP",
            "GÜÇLÜ DESTEK TEYİDİ YOK": "teyit yok",
        }
        resistance_labels = {
            "GÜÇLÜ DİRENÇ BÖLGESİ İÇİNDE": "içinde",
            "ÜSTÜNDEKİ GÜÇLÜ DİRENÇ BEKLENİYOR": "üstte",
            "GÜÇLÜ DİRENÇ ÜSTÜNDE — DEVAMLILIK TEYİDİ GEREKİR": "aşılmış; devam teyidi bekliyor",
            "TEYİTLİ GÜÇLÜ DİRENÇ YOK": "teyit yok",
        }
        channel_labels = {
            "TEYİTLİ KANAL İÇİNDE": "içinde",
            "KANAL ALT SINIRI KAYBEDİLDİ": "alt sınır KAYIP",
            "KANAL ÜSTÜ KIRILIM ADAYI — DEVAMLILIK BEKLENİYOR": "üst kırılım; teyit bekleniyor",
            "KANAL KONUMU HESAPLANAMADI": "konum belirsiz",
        }
        support_raw = str(row.get("support_status") or "GÜÇLÜ DESTEK TEYİDİ YOK")
        resistance_raw = str(row.get("resistance_status") or "TEYİTLİ GÜÇLÜ DİRENÇ YOK")
        support_status = support_labels.get(support_raw, support_raw)
        resistance_status = resistance_labels.get(resistance_raw, resistance_raw)
        support = zone_text(row.get("latest_confirmed_support_zone"))
        resistance = zone_text(row.get("nearest_relevant_resistance_zone"))
        channel = row.get("confirmed_channel")
        channel_status_raw = str(row.get("channel_status") or "KANAL TEYİDİ YOK")
        channel_status = channel_labels.get(channel_status_raw, channel_status_raw)
        if isinstance(channel, dict) and channel.get("available") is True:
            lower, upper = price(channel.get("lower_now")), price(channel.get("upper_now"))
            channel_text = f"{lower}–{upper}" if lower != "—" and upper != "—" else "teyitli"
            channel_text += f" {channel_status}"
        else:
            channel_text = channel_status
        frame_summaries.append(
            f"{timeframe}: {direction}; destek {support} {support_status}; "
            f"direnç {resistance} {resistance_status}; kanal {channel_text}"
        )

    def brief_risk(value: str) -> str:
        timeframe = "1h" if "1h" in value else "4h" if "4h" in value else "BTC"
        lower_value = value.casefold()
        if "kanal alt sınırı" in lower_value:
            reason = "kanal alt sınırı kaybı"
        elif "destek" in lower_value and ("altında kapanış" in lower_value or "kaybedildi" in lower_value):
            reason = "destek kaybı"
        elif "oynaklık" in lower_value:
            reason = "oynaklık yüksek"
        else:
            cleaned = " ".join(value.split())
            reason = cleaned[:48] + ("…" if len(cleaned) > 48 else "")
        return f"BTC {timeframe}: {reason}"

    warnings = context.get("risk_warnings")
    warnings = [brief_risk(item) for item in warnings if isinstance(item, str) and item] if isinstance(warnings, list) else []
    quality = context.get("data_quality_warnings")
    quality = [str(item) for item in quality if isinstance(item, str) and item] if isinstance(quality, list) else []
    suffix = []
    if warnings:
        suffix.append("RİSK: " + "; ".join(warnings[:2]))
    elif context.get("data_completeness") != "TAM" and quality:
        suffix.append("VERİ: " + quality[0])
    return "BTC | " + " | ".join(frame_summaries) + (
        " | " + " | ".join(suffix) if suffix else ""
    )


def _btc_context_display_summary(
    context: Any,
    *,
    current: bool,
    freshness: str | None = None,
) -> str:
    """Show BTC structure and the shared strong-alert eligibility gate on the main panel."""
    summary = _btc_market_context_summary(context, current=current)
    gate = assess_btc_strong_opportunity_gate(
        context if isinstance(context, dict) else {},
        freshness=freshness if current else "ESKİ/EKSİK",
        require_measurements=True,
    )
    if gate["eligible"]:
        return summary + " | BTC güçlü fırsat/alarm kapısı: AÇIK"
    reasons = [item for item in gate.get("reasons", []) if isinstance(item, str) and item]
    reason_text = "; ".join(reasons[:2]) if reasons else "BTC ölçümleri yetersiz veya risk eşiği aşıldı."
    return summary + " | BTC güçlü fırsat/alarm kapısı: KAPALI — " + reason_text


def _btc_correlation_summary(row: dict[str, Any], *, current: bool) -> str:
    """Summarize BTC co-movement without exposing stale measurements as current."""
    btc_freshness = row.get("btc_market_context_freshness")
    if not current or (
        btc_freshness is not None and btc_freshness != "CANLI AKIŞ GÜNCEL"
    ):
        return "BTC canlı verisi eski/eksik; güncel korelasyon yok"
    raw = row.get("btc_return_correlation")
    if not isinstance(raw, dict):
        return "hesaplanamadı"
    summaries = []
    for timeframe, label, default_minimum in (("1h", "1 saat", 60), ("4h", "4 saat", 34)):
        assessment = raw.get(timeframe)
        if not isinstance(assessment, dict):
            summaries.append(f"{label} hesaplanamadı")
            continue
        value = assessment.get("value")
        observations = assessment.get("observations", 0)
        minimum = assessment.get("minimum_required", default_minimum)
        valid_observations = (
            isinstance(observations, int) and not isinstance(observations, bool)
            and observations >= 0
        )
        valid_minimum = (
            isinstance(minimum, int) and not isinstance(minimum, bool)
            and minimum > 0
        )
        if (
            isinstance(value, (int, float)) and not isinstance(value, bool)
            and math.isfinite(float(value)) and -1.0 <= float(value) <= 1.0
        ):
            suffix = f" ({observations} gözlem)" if valid_observations else ""
            summaries.append(f"{label} {float(value):+.2f}{suffix}")
        elif valid_observations and valid_minimum and observations < minimum:
            summaries.append(f"{label} yetersiz ({observations}/{minimum})")
        else:
            summaries.append(f"{label} hesaplanamadı")
    return "; ".join(summaries)


def _write_transfer_bundle(
    report: dict[str, Any], json_path: Path, markdown_path: Path, bundle_path: Path
) -> dict[str, Any]:
    """Create one compressed, integrity-verifiable package for support and chat transfer."""
    state = report.get("source_state")
    if not isinstance(state, dict):
        state = {}
    settings_path = Path(SETTINGS_PATH)
    settings_exists = settings_path.is_file()
    settings_parse_status = "MISSING"
    settings_parse_error: str | None = None
    settings_size_bytes: int | None = None
    settings_mtime_utc: str | None = None
    settings_sha256: str | None = None
    fan_count: int | None = None
    stable_count: int | None = None
    fan_valid = stable_valid = False
    try:
        settings_bytes = settings_path.read_bytes()
        settings_exists = True
        settings_size_bytes = len(settings_bytes)
        settings_sha256 = hashlib.sha256(settings_bytes).hexdigest()
        settings_mtime_utc = datetime.fromtimestamp(
            settings_path.stat().st_mtime, timezone.utc
        ).isoformat(timespec="seconds")
        config = json.loads(settings_bytes.decode("utf-8-sig"))
        if not isinstance(config, dict):
            settings_parse_status = "ROOT_NOT_OBJECT"
            settings_parse_error = "JSON kökü bir nesne/sözlük değil."
        else:
            fan_list = config.get("fan_token_bases_to_skip")
            stable_list = config.get("stablecoin_bases_no_strong_alarm")
            fan_valid = isinstance(fan_list, list) and bool(fan_list) and all(
                isinstance(item, str) and item.strip() for item in fan_list
            )
            stable_valid = isinstance(stable_list, list) and bool(stable_list) and all(
                isinstance(item, str) and item.strip() for item in stable_list
            )
            fan_count = len(fan_list) if fan_valid else None
            stable_count = len(stable_list) if stable_valid else None
            settings_parse_status = (
                "OK" if fan_valid and stable_valid
                else "JSON_OK_FILTERS_INVALID"
            )
    except FileNotFoundError:
        settings_exists = False
        settings_parse_status = "MISSING"
        settings_parse_error = "ayarlar.json dosyası bulunamadı."
    except UnicodeDecodeError as exc:
        settings_parse_status = "INVALID_ENCODING"
        settings_parse_error = f"{type(exc).__name__}: {exc}"[:300]
    except json.JSONDecodeError as exc:
        settings_parse_status = "INVALID_JSON"
        settings_parse_error = f"{exc.msg} (satır {exc.lineno}, sütun {exc.colno})"[:300]
    except OSError as exc:
        settings_parse_status = "READ_ERROR"
        settings_parse_error = f"{type(exc).__name__}: {exc}"[:300]

    log_path = LOG_DIR / "tek_motor_paneli.log"
    log_present = log_path.is_file()
    log_truncated = False
    if log_present:
        try:
            log_text = "\n".join(log_path.read_text(
                encoding="utf-8", errors="replace"
            ).splitlines()[-300:])
            encoded_log = log_text.encode("utf-8")
            if len(encoded_log) > 128 * 1024:
                log_text = encoded_log[-(128 * 1024):].decode("utf-8", errors="replace")
                log_truncated = True
        except OSError as exc:
            log_text = f"Günlük okunamadı: {type(exc).__name__}: {exc}"
    else:
        log_text = "Bu çalıştırmada tek_motor_paneli.log bulunamadı."
    log_text += "\n"

    diagnostic = {
        "package_version": 1,
        "application_version": APP_VERSION,
        "application": "FIRSAT-KONTROL PANELİ — Tek Motor",
        "created_at_local": datetime.now().astimezone().isoformat(timespec="seconds"),
        "report_file": json_path.name,
        "markdown_file": markdown_path.name,
        "runtime": {
            "python_version": sys.version.split()[0],
            "platform": sys.platform,
            "executable_name": Path(sys.executable).name,
            "application_root": str(ROOT.resolve(strict=False)),
        },
        "settings_file": {
            "path": str(settings_path.resolve(strict=False)),
            "exists": settings_exists,
