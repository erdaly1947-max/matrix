def _theme_for_brightness(value: int) -> dict[str, str]:
    """Build a neutral gray surface palette without changing signal/status colors."""
    level = max(0, min(100, int(value)))
    shade = round(145 + (level * 0.65))
    background = f"#{shade:02X}{shade:02X}{shade:02X}"
    panel_shade = min(242, shade + 12)
    panel_alt_shade = max(92, shade - 10)
    field_shade = min(250, shade + 22)
    return {
        "background": background,
        "panel": f"#{panel_shade:02X}{panel_shade:02X}{panel_shade:02X}",
        "panel_alt": f"#{panel_alt_shade:02X}{panel_alt_shade:02X}{panel_alt_shade:02X}",
        "field": f"#{field_shade:02X}{field_shade:02X}{field_shade:02X}",
        "text": "#222222",
        "muted": "#444444",
        "border": "#FFFFFF",
        "accent": STATUS_COLORS["red"],
        "accent_active": "#E53935",
        "selection": STATUS_COLORS["navy"],
        "scrollbar": "#777777",
        "stale": STATUS_COLORS["blue"],
    }


def _opportunity_score_value(row: dict[str, Any]) -> float | None:
    """Read an explicit, finite opportunity score from 0 to 100."""
    for key in ("opportunity_score", "score_0_100"):
        value = row.get(key)
        if isinstance(value, (int, float)) and not isinstance(value, bool):
            score = float(value)
            if math.isfinite(score) and 0.0 <= score <= 100.0:
                return score
    return None


def _opportunity_score_text(row: dict[str, Any]) -> str:
    if row.get("data_freshness") != "CANLI AKIŞ GÜNCEL":
        return "—"
    score = _opportunity_score_value(row)
    return f"{score:g}" if score is not None else "—"


def _final_decision_text(row: dict[str, Any]) -> str:
    """Use only a fresh, explicit engine decision; never infer it from A/B/C."""
    if row.get("data_freshness") != "CANLI AKIŞ GÜNCEL":
        return "KARAR BEKLENİYOR"
    raw = row.get("final_decision") or row.get("decision_class")
    decision = " ".join(str(raw or "").strip().upper().split())
    if decision not in FINAL_DECISIONS:
        return "KARAR BEKLENİYOR"
    if decision == "GÜÇLÜ FIRSAT":
        score = _opportunity_score_value(row)
        if not (
            score is not None and score >= 80
            and row.get("phase") in ("B", "C")
            and row.get("strong_alarm_eligible") is True
            and row.get("strong_opportunity_qualified") is True
        ):
            return "KARAR BEKLENİYOR"
    return decision


def _initial_panel_geometry(screen_width: int, screen_height: int) -> tuple[int, int, int, int]:
    """Return an 80%-width window with a 12% height margin."""
    width = max(1, int(screen_width))
    height = max(1, int(screen_height))
    window_width = int(width * 0.80) if width >= 1200 else int(width * 0.90)
    window_width = max(1, min(width, window_width))
    # Reserve extra room for Windows title-bar/frame decorations and the taskbar.
    window_height = max(1, min(height, int(height * 0.88)))
    x = 0
    y = max(0, (height - window_height) // 2)
    return window_width, window_height, x, y


