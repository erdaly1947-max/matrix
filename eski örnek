        if live:
            self.engine_badge.configure(bg=STATUS_COLORS["green"], fg="#FFFFFF")
        elif process_running:
            self.engine_badge.configure(bg=STATUS_COLORS["yellow"], fg="#222222")
        elif status == "BAŞLATMA HATASI":
            self.engine_badge.configure(bg=STATUS_COLORS["red"], fg="#FFFFFF")
        else:
            self.engine_badge.configure(bg=THEME["panel_alt"], fg=THEME["text"])
        self._refresh_candidates()
        self._refresh_alert_lifecycle()

    def _copy_report_to_clipboard(self, report_text: str) -> bool:
        """Copy the readable Markdown report so it can be pasted into ChatGPT directly."""
        try:
            self.root.clipboard_clear()
            self.root.clipboard_append(report_text)
            self.root.update_idletasks()
            return True
        except tk.TclError as exc:
            self._append_log(f"Rapor metni panoya kopyalanamadı: {exc}")
            return False

    @staticmethod
    def _reveal_report_file(path: Path) -> bool:
        """Open Windows Explorer with the generated JSON report selected."""
        if os.name != "nt":
            return False
        try:
            subprocess.Popen(["explorer.exe", "/select,", str(path)])
            return True
        except OSError:
            try:
                os.startfile(str(path.parent))  # type: ignore[attr-defined]
                return True
            except OSError:
                return False

    def _create_report(self) -> None:
        state = self._state if isinstance(self._state, dict) else {}
        state_is_live = self._state_is_live()
        btc_context_current = (
            state_is_live and state.get("btc_market_context_freshness") == "CANLI AKIŞ GÜNCEL"
        )
        btc_strong_gate = assess_btc_strong_opportunity_gate(
            state.get("btc_market_context"),
            freshness=(
                state.get("btc_market_context_freshness")
                if btc_context_current else "ESKİ/EKSİK"
            ),
            require_measurements=True,
        )

        def redact_report_btc_metrics(safe_row: dict[str, Any], note: str) -> None:
            relative = safe_row.get("relative_strength_vs_btc_pct_points")
            safe_row["relative_strength_vs_btc_pct_points"] = (
                {str(key): None for key in relative}
                if isinstance(relative, dict) else
                {"15m": None, "1h": None, "4h": None}
            )
            correlations = safe_row.get("btc_return_correlation")
            cleaned_correlations = {}
            if isinstance(correlations, dict):
                for timeframe, measurement in correlations.items():
                    if isinstance(measurement, dict):
                        cleaned_correlations[str(timeframe)] = {
                            **measurement, "value": None, "current": False,
                            "status": "BTC canlı verisi eski/eksik",
                            "unavailable_reason": note,
                        }
                    else:
                        cleaned_correlations[str(timeframe)] = {
                            "value": None, "current": False,
                            "status": "BTC canlı verisi eski/eksik",
                            "unavailable_reason": note,
                        }
            safe_row["btc_return_correlation"] = cleaned_correlations
            safe_row["btc_market_context"] = {
                "status": "BTC VERİSİ ESKİ/EKSİK", "data_completeness": "EKSİK",
                "direction_score": 0.0, "critical_level_score": 0.0,
                "volatility_score": 0.0, "total_score": 0.0, "timeframes": {},
                "risk_warnings": [], "data_quality_warnings": [note],
            }
            safe_row["btc_market_context_freshness"] = "ESKİ/EKSİK"
            safe_row["btc_context_conflict_note"] = None
            findings = safe_row.get("findings")
            if isinstance(findings, list):
                safe_row["findings"] = [
                    item for item in findings
                    if not (
                        isinstance(item, str)
                        and (
                            "göreceli güç pozitif" in item.casefold()
                            or ("btc'ye göre" in item.casefold() and "göreceli güç" in item.casefold())
                            or "grup liderliği:" in item.casefold()
                        )
                    )
                ]
            missing = safe_row.get("missing_checks")
            missing_items = [item for item in missing if isinstance(item, str)] if isinstance(missing, list) else []
            missing_items.append(note)
            safe_row["missing_checks"] = sorted(set(missing_items))
            safe_row["group_leadership_score"] = 0
            safe_row["group_leadership_summary"] = None
            safe_row["group_leadership_basis"] = note
            safe_row["strong_opportunity_qualified"] = False
            existing_gates = safe_row.get("strong_opportunity_gate_reasons")
            existing_gates = (
                [item for item in existing_gates if isinstance(item, str)]
                if isinstance(existing_gates, list) else []
            )
            safe_row["strong_opportunity_gate_reasons"] = list(dict.fromkeys([
                *existing_gates,
                "BTC canlı bağlamı eski/eksik; güçlü fırsat ve alarm uygun değil.",
            ]))
            previous_decision = safe_row.get("final_decision") or safe_row.get("decision_class")
            if previous_decision:
                safe_row["last_known_final_decision"] = previous_decision
            safe_row["final_decision"] = None
            safe_row["decision_class"] = None
            safe_row["decision_reason"] = (
                "BTC canlı bağlamı eski/eksik; birleşik puan ve nihai karar yeniden doğrulanmalı."
            )
            safe_row["opportunity_score"] = None
            safe_row["score_0_100"] = None

        def report_candidate(row: dict[str, Any]) -> dict[str, Any]:
            safe_row = dict(row)
            row_live = state_is_live and row.get("data_freshness") == "CANLI AKIŞ GÜNCEL"
            candidate_btc_live = (
                btc_context_current
                and row.get("btc_market_context_freshness") == "CANLI AKIŞ GÜNCEL"
            )
            if row_live and candidate_btc_live:
                if not btc_strong_gate["eligible"]:
                    safe_row["strong_opportunity_qualified"] = False
                    if (
                        safe_row.get("final_decision") == "GÜÇLÜ FIRSAT"
                        or safe_row.get("decision_class") == "GÜÇLÜ FIRSAT"
                    ):
                        safe_row["final_decision"] = "ERKEN ADAY"
                        safe_row["decision_class"] = "ERKEN ADAY"
                        safe_row["decision_reason"] = (
                            "BTC ölçümleri güncel; ancak piyasa risk kapısı nedeniyle güçlü fırsat uygun değil."
                        )
                    existing_gates = safe_row.get("strong_opportunity_gate_reasons")
                    existing_gates = (
                        [item for item in existing_gates if isinstance(item, str)]
                        if isinstance(existing_gates, list) else []
                    )
                    safe_row["strong_opportunity_gate_reasons"] = list(dict.fromkeys([
                        *existing_gates, *btc_strong_gate["reasons"],
                    ]))
                return safe_row
            if row_live and not candidate_btc_live:
                redact_report_btc_metrics(
                    safe_row,
                    "BTC canlı bağlamı eski/eksik; göreceli güç, korelasyon ve grup liderliği güncel kabul edilmiyor.",
                )
                return safe_row
            btc_note = (
                "Rapor oluşturulurken genel motor canlı değildi; BTC göreceli güç, korelasyon "
                "ve grup liderliği güncel kabul edilemez."
            )
            relative = safe_row.get("relative_strength_vs_btc_pct_points")
            safe_row["relative_strength_vs_btc_pct_points"] = (
                {str(key): None for key in relative}
                if isinstance(relative, dict) else
                {"15m": None, "1h": None, "4h": None}
            )
            correlations = safe_row.get("btc_return_correlation")
            sanitized_correlations = {}
            if isinstance(correlations, dict):
                for timeframe, measurement in correlations.items():
                    if isinstance(measurement, dict):
                        sanitized_correlations[str(timeframe)] = {
                            **measurement,
                            "value": None,
                            "current": False,
                            "status": "BTC canlı verisi eski/eksik",
                            "unavailable_reason": btc_note,
