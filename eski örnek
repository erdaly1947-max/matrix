    def _load_panel_preferences(self) -> dict[str, Any]:
        """Read optional UI preferences without changing the engine's existing settings."""
        try:
            if not self._settings_path.is_file():
                return {}
            with self._settings_path.open("r", encoding="utf-8") as handle:
                settings = json.load(handle)
        except (OSError, json.JSONDecodeError) as exc:
            self._append_log(f"Panel ayarları okunamadı; varsayılanlar kullanılıyor: {exc}")
            return {}
        if not isinstance(settings, dict):
            return {}
        panel_settings = settings.get("panel_ui")
        return panel_settings if isinstance(panel_settings, dict) else {}

    def _save_panel_preferences(self) -> bool:
        """Merge UI preferences into ayarlar.json; retain every unrelated engine setting."""
        try:
            if self._settings_path.is_file():
                with self._settings_path.open("r", encoding="utf-8") as handle:
                    settings = json.load(handle)
                if not isinstance(settings, dict):
                    raise ValueError("ayarlar.json üst düzeyde nesne içermiyor")
            else:
                settings = {}
            panel_settings = settings.get("panel_ui")
            if not isinstance(panel_settings, dict):
                panel_settings = {}
            panel_settings["alarm_sound_enabled"] = bool(self.alarm_sound_enabled_var.get())
            panel_settings["alarm_volume"] = max(0, min(100, int(self.alarm_volume_var.get())))
            panel_settings["screen_brightness"] = max(
                0, min(100, int(self.screen_brightness_var.get()))
            )
            settings["panel_ui"] = panel_settings
            atomic_json(self._settings_path, settings)
            return True
        except (OSError, ValueError, TypeError, json.JSONDecodeError) as exc:
            self._append_log(f"Panel ayarları kaydedilemedi; mevcut ayarlar korunuyor: {exc}")
            return False

