                missing_checks = selected.get("missing_checks", [])
                missing_text = (
                    "; ".join(str(item) for item in missing_checks[:5])
                    if selected_fresh and isinstance(missing_checks, list) and missing_checks
                    else "Veri eski/eksik; güncel teyit durumu üretilemez."
                    if not selected_fresh else "Kayıtlı eksik teyit yok."
                )
                table.extend([
                    "", "## Seçilen coin", "",
                    f"- Parite: {selected.get('symbol', '—')}",
                    f"- Nihai karar: {selected_decision}",
                    f"- Fırsat puanı: {selected_score + '/100' if selected_score != '—' else '—'}",
