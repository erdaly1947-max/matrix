    def _engine_command(self) -> list[str]:
        if getattr(sys, "frozen", False):
            worker = ROOT / "binance_erken_firsat_radari.exe"
            if not worker.is_file():
                raise FileNotFoundError("Binance motoru dosyası pakette bulunamadı.")
            return [str(worker)]
        worker = ROOT / "binance_erken_firsat_radari.py"
        return [_python_console_exe(), str(worker)]

    def _start_engine(self) -> None:
        if self.process is not None and self.process.poll() is None:
            self._append_log("Binance motoru zaten çalışıyor.")
            return
        try:
            STOP_PATH.unlink(missing_ok=True)
            REFRESH_PATH.unlink(missing_ok=True)
            atomic_json(STATE_PATH, {
                "radar": "Tek Motor — Binance Spot",
                "status": "BAŞLATILIYOR",
                "generated_at_utc": utc_now(),
                "candidates": [],
            })
            command = self._engine_command() + [
                "--stop-file", str(STOP_PATH), "--single-engine"
            ]
            env = os.environ.copy()
            env["PYTHONUTF8"] = "1"
            env["PYTHONIOENCODING"] = "utf-8"
            self.process = subprocess.Popen(
                command,
                cwd=str(ROOT),
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                encoding="utf-8",
                errors="replace",
                bufsize=1,
                env=env,
                creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0) if os.name == "nt" else 0,
            )
            self._start_clock = _now_clock()
            self.start_clock_var.set(f"Başlatma saati: {self._start_clock}")
            self.engine_status.set("Başlatılıyor")
            self.start_button.configure(state="disabled")
            self.stop_button.configure(state="normal")
            self._active_opportunities.clear()
            self._inactive_since.clear()
            self._last_alert_reason.clear()
            self._last_strong_keys.clear()
            thread = threading.Thread(target=self._read_process_output, args=(self.process,), daemon=True)
            thread.start()
            self._append_log("Binance tek analiz motoru başlatıldı.")
        except Exception as exc:
            self.engine_status.set("Başlatma hatası")
            self._append_log(f"Motor başlatılamadı: {exc}")
            messagebox.showerror("Motor başlatılamadı", str(exc), parent=self.root)
            self.start_button.configure(state="normal")
            self.stop_button.configure(state="disabled")

    def _read_process_output(self, process: subprocess.Popen[str]) -> None:
        stream = process.stdout
        if stream is None:
            return
        try:
            for line in stream:
                self.output_queue.put(line.rstrip())
        except (OSError, ValueError) as exc:
            self.output_queue.put(f"Motor çıktısı okunamadı: {exc}")

    def _stop_engine(self) -> None:
        if self.process is None or self.process.poll() is not None:
            self.engine_status.set("Durduruldu")
            self._append_log("Çalışan Binance motoru yok.")
            return
        try:
            STOP_PATH.write_text("stop\n", encoding="utf-8")
            self.engine_status.set("Durduruluyor")
            self._append_log("Binance motoruna kontrollü durdurma istendi.")
            self.stop_button.configure(state="disabled")
        except OSError as exc:
            self._append_log(f"Durdurma isteği yazılamadı: {exc}")

