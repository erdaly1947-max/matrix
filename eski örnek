                    else:
                        sanitized_correlations[str(timeframe)] = {
                            "value": None, "current": False,
                            "status": "BTC canlı verisi eski/eksik",
                            "unavailable_reason": btc_note,
                        }
            safe_row["btc_return_correlation"] = sanitized_correlations
            safe_row["btc_market_context"] = {
                "status": "BTC VERİSİ ESKİ/EKSİK",
                "data_completeness": "EKSİK",
                "direction_score": 0.0,
                "critical_level_score": 0.0,
                "volatility_score": 0.0,
                "total_score": 0.0,
                "timeframes": {},
                "risk_warnings": [],
                "data_quality_warnings": [btc_note],
            }
            findings = safe_row.get("findings")
            if isinstance(findings, list):
                safe_row["findings"] = [
                    item for item in findings
                    if not (
                        isinstance(item, str)
                        and (
                            "göreceli güç pozitif" in item.casefold()
                            or ("btc'ye göre" in item.casefold() and "göreceli güç" in item.casefold())
                            or "grup liderliği:" in item.casefold()
                        )
                    )
                ]
            missing = safe_row.get("missing_checks")
            missing_items = [
                item for item in missing if isinstance(item, str)
            ] if isinstance(missing, list) else []
            missing_items.append(btc_note)
            previous_decision = safe_row.get("final_decision") or safe_row.get("decision_class")
            if previous_decision:
                safe_row["last_known_final_decision"] = previous_decision
            previous_phase = safe_row.get("phase")
            if previous_phase in PHASE_COLORS and safe_row.get("last_known_phase") not in PHASE_COLORS:
                safe_row["last_known_phase"] = previous_phase
            safe_row["phase"] = None
            if safe_row.get("last_known_phase") in PHASE_COLORS:
                safe_row["state"] = "VERİ ESKİ/EKSİK — SON AŞAMA GÜNCEL TEYİT DEĞİL"
            safe_row.update({
                "data_freshness": "CANLI VERİ ESKİ/EKSİK",
                "btc_market_context_freshness": "ESKİ/EKSİK",
                "latest_price": None,
                "final_decision": None,
                "decision_class": None,
                "opportunity_score": None,
                "score_0_100": None,
                "decision_reason": "Veri eski/eksik; güncel karar doğrulanamadı.",
                "risk_plan": None,
                "btc_context_conflict_note": None,
                "group_leadership_score": 0,
                "group_leadership_summary": None,
                "group_leadership_basis": btc_note,
                "missing_checks": sorted(set(missing_items)),
            })
            return safe_row

        candidates = [report_candidate(row) for row in self._current_rows()]
        stamp = datetime.now().astimezone().strftime("%Y%m%d_%H%M%S")
        report_dir = ROOT / "reports"
        report_dir.mkdir(parents=True, exist_ok=True)
        json_path = report_dir / f"TEK_MOTOR_RAPORU_{stamp}.json"
        md_path = report_dir / f"TEK_MOTOR_RAPORU_{stamp}.md"
        bundle_path = report_dir / f"RAPOR_DEVIR_PAKETI_{stamp}.zip"
        selected_source = None
        selected_ids = self.candidate_tree.selection()
        if selected_ids:
            selected_source = self._rows_by_symbol.get(selected_ids[0])
        selected = report_candidate(selected_source) if isinstance(selected_source, dict) else None
