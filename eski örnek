            cache_warning = (
                state.get("single_engine_universe_cache_warning")
                or state.get("universe_warning")
                or state.get("btcturk_universe_warning")
            )
            local_summary = (
                f"ORTAK EVREN YEDEK ÖNBELLEĞİ · Son doğrulama: {stamp_text[:32]} · "
                f"Önbellek yaşı: {cache_age_text} · Güçlü fırsat alarmı: KAPALI"
            )
            if cache_warning:
                local_summary += " · UYARI: " + " ".join(str(cache_warning).split())
            self.btcturk_list_var.set(
                f"Ortak evren yedek önbelleği · son doğrulama: {stamp_text[:32]} · "
                f"yaş: {cache_age_text} · güçlü alarm: KAPALI"
            )
        self.universe_summary.set(local_summary)
        pair_text = f"{pair_count} parite" if isinstance(pair_count, int) else "doğrulanmış sayı yok"
        self.universe_market_var.set("Binance Spot USDT")
        self.universe_pairs_var.set(f"{pair_text} · {self.universe_mode_var.get()}")
        self.universe_compact_var.set(
            f"Son evren kaydı: {stamp_text[:32]} · BtcTurk yerel liste durumu: {local_summary}"
        )
