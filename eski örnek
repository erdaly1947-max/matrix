    def _handle_queues(self) -> None:
        while True:
            try:
                line = self.output_queue.get_nowait()
            except queue.Empty:
                break
            if line:
                self._append_log(line)
        while True:
            try:
                kind, payload = self.event_queue.get_nowait()
            except queue.Empty:
                break
            if kind == "list_ok":
                self.update_list_button.configure(state="normal")
                self._append_log(
                    f"Yerel BtcTurk listesi kaydedildi: {payload.get('count')} parite, "
                    f"zaman={payload.get('generated_at_utc')}."
                )
                if self.process is not None and self.process.poll() is None:
                    try:
                        REFRESH_PATH.write_text("refresh\n", encoding="utf-8")
                        self._append_log("Motorun sembol evreni yenilemesi istendi.")
                    except OSError as exc:
                        self._append_log(f"Motor evren yenileme isteği yazılamadı: {exc}")
            elif kind == "list_error":
                self.update_list_button.configure(state="normal")
                self._append_log(f"Yerel BtcTurk listesi güncellenemedi: {payload}")
                messagebox.showwarning(
                    "Parite listesi güncellenemedi", str(payload), parent=self.root
                )

    def _poll(self) -> None:
        if self.closing:
            return
        self._handle_queues()
        if self.process is not None and self.process.poll() is not None:
            code = self.process.returncode
            self.process = None
            self.stop_button.configure(state="disabled")
            self.start_button.configure(state="normal")
            self._stop_clock = _now_clock()
            self.stop_clock_var.set(f"Durdurma saati: {self._stop_clock}")
            self._append_log(f"Binance motoru kapandı; çıkış kodu={code}.")
        try:
            self._refresh_state()
        except Exception as exc:
            self._append_log(f"Panel güncelleme hatası: {exc}")
        self._poll_after_id = self.root.after(1000, self._poll)

    def _cancel_scheduled_callbacks(self, event: Any = None) -> None:
        """Cancel Tk after callbacks when the panel is destroyed, including in tests."""
        if event is not None and getattr(event, "widget", self.root) is not self.root:
            return
        for attribute in ("_titlebar_after_id", "_poll_after_id"):
            callback_id = getattr(self, attribute, None)
            if not callback_id:
                continue
            try:
                self.root.after_cancel(callback_id)
            except tk.TclError:
                pass
            setattr(self, attribute, None)

    def _on_close(self) -> None:
        self.closing = True
        self._cancel_scheduled_callbacks()
        if self.process is not None and self.process.poll() is None:
            try:
                STOP_PATH.write_text("stop\n", encoding="utf-8")
                self.process.wait(timeout=3)
            except (OSError, subprocess.TimeoutExpired):
                try:
                    self.process.terminate()
                except OSError:
                    pass
        self.root.destroy()


def main() -> None:
    root = tk.Tk()
    TekMotorPanel(root)
    root.mainloop()


if __name__ == "__main__":
    main()
