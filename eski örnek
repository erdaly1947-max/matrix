class RoundedButton(tk.Canvas):
    """Compact rounded action button matching the original dashboard styling."""

    def __init__(self, master: tk.Misc, *, text: str, command: Any, background: str,
                 accent: str = THEME["accent"], hover: str = THEME["accent_active"],
                 foreground: str = "#FFFFFF", font: tuple[Any, ...] = ("Segoe UI", 11, "bold"),
                 padx: int = 9, height: int = 30, state: str = "normal"):
        self._text, self._command = str(text), command
        self._background, self._accent, self._hover = background, accent, hover
        self._foreground = foreground
        self._font = tkfont.Font(root=master.winfo_toplevel(), font=font)
        self._width = max(42, int(self._font.measure(self._text)) + 2 * int(padx))
        self._height, self._state = max(20, int(height)), state
        self._hovering = self._pressed = False
        super().__init__(master, width=self._width, height=self._height, background=background,
                         borderwidth=0, highlightthickness=1, highlightbackground=background,
                         highlightcolor="#FBC02D", relief="flat", takefocus=True, cursor="hand2")
        self._draw()
        self.bind("<Enter>", self._on_enter)
        self.bind("<Leave>", self._on_leave)
        self.bind("<ButtonPress-1>", self._on_press)
        self.bind("<ButtonRelease-1>", self._on_release)
        self.bind("<Return>", self._on_keyboard_activate)
        self.bind("<space>", self._on_keyboard_activate)
        self.bind("<FocusIn>", self._on_focus_in)
        self.bind("<FocusOut>", self._on_focus_out)

    def cget(self, key: str) -> Any:
        if key == "text": return self._text
        if key == "state": return self._state
        return super().cget(key)

    def __getitem__(self, key: str) -> Any:
        return self.cget(key)

    def configure(self, cnf: Any = None, **kwargs: Any) -> Any:
        redraw = False
        if "state" in kwargs:
            self._state = str(kwargs.pop("state")); redraw = True
        if "text" in kwargs:
            self._text = str(kwargs.pop("text"))
            self._width = max(42, int(self._font.measure(self._text)) + 24)
            super().configure(width=self._width); redraw = True
        result = super().configure(cnf, **kwargs) if (cnf is not None or kwargs) else None
        if redraw: self._draw()
        return result

    config = configure

    def invoke(self) -> Any:
        if self._state != "disabled" and callable(self._command):
            return self._command()
        return None

    def set_colors(self, *, accent: str, hover: str, foreground: str = "#FFFFFF") -> None:
        self._accent, self._hover, self._foreground = accent, hover, foreground
        self._draw()

    def _draw(self) -> None:
        self.delete("all")
        color = (THEME["panel_alt"] if self._state == "disabled"
                 else self._hover if self._hovering and not self._pressed else self._accent)
        foreground = THEME["muted"] if self._state == "disabled" else self._foreground
        inset, top, bottom = 1, 1, self._height - 1
        cap = min(self._height - 2, self._width)
        self.create_oval(inset, top, inset + cap, bottom, fill=color, outline=color)
        self.create_oval(self._width-inset-cap, top, self._width-inset, bottom, fill=color, outline=color)
        self.create_rectangle(inset+cap/2, top, self._width-inset-cap/2, bottom, fill=color, outline=color)
        self.create_text(self._width/2, self._height/2+1, text=self._text,
                         fill=foreground, font=self._font, anchor="center")

    def _on_enter(self, _event: tk.Event[Any]) -> None:
        self._hovering = True; self._draw()

    def _on_leave(self, _event: tk.Event[Any]) -> None:
        self._hovering = False; self._pressed = False; self._draw()

    def _on_press(self, _event: tk.Event[Any]) -> None:
        if self._state != "disabled":
            self.focus_set(); self._pressed = True; self._draw()

    def _on_release(self, event: tk.Event[Any]) -> None:
        should_invoke = (self._state != "disabled" and self._pressed
                         and 0 <= event.x <= self._width and 0 <= event.y <= self._height)
        self._pressed = False; self._draw()
        if should_invoke: self.invoke()

    def _on_keyboard_activate(self, _event: tk.Event[Any]) -> str:
        self.invoke(); return "break"

    def _on_focus_in(self, _event: tk.Event[Any]) -> None:
        self.configure(highlightbackground="#F2C94C")

    def _on_focus_out(self, _event: tk.Event[Any]) -> None:
        self.configure(highlightbackground=self._background)


def _configure_panel_logger(log_dir: Path) -> logging.Logger:
    """Keep UI and worker stdout/stderr diagnostics in a rotating log file."""
    log_path = (Path(log_dir) / "tek_motor_paneli.log").resolve(strict=False)
    key = hashlib.sha256(str(log_path).casefold().encode("utf-8")).hexdigest()[:16]
    logger = logging.getLogger(f"firsat_kontrol_paneli.ui.{key}")
    logger.setLevel(logging.INFO)
    logger.propagate = False
    if not logger.handlers:
        try:
            log_path.parent.mkdir(parents=True, exist_ok=True)
            handler = RotatingFileHandler(
                log_path, maxBytes=2_000_000, backupCount=3, encoding="utf-8"
            )
            handler.setFormatter(logging.Formatter("%(asctime)s | %(levelname)s | %(message)s"))
            logger.addHandler(handler)
        except OSError:
            # Diagnostics must not prevent the panel from starting on a read-only folder.
            logger.addHandler(logging.NullHandler())
    return logger


