            cache_age = state.get("single_engine_universe_cache_age_seconds")
            if isinstance(cache_age, (int, float)) and cache_age >= 0:
                if cache_age >= 86400:
                    cache_age_text = f"{cache_age / 86400:.1f} gün"
                elif cache_age >= 3600:
                    cache_age_text = f"{cache_age / 3600:.1f} saat"
                elif cache_age >= 60:
                    cache_age_text = f"{cache_age / 60:.1f} dakika"
                else:
